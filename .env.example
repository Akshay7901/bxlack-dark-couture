# Copy to .env for local development. In production, set these in
# Vercel → Project → Settings → Environment Variables.

# Supabase → Project Settings → API
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Same URL and publishable key, exposed to the browser bundle
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Resend (emails are skipped while RESEND_API_KEY or EMAIL_FROM is empty)
RESEND_API_KEY=
EMAIL_FROM=BXLACK <orders@yourdomain.com>
EMAIL_REPLY_TO=
ADMIN_NOTIFY_EMAIL=
